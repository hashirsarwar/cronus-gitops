# The deploy key's private half is never committed. It is generated by hand, added to GitHub
# as a read-only deploy key on this repository, and handed to the cluster as a Secret by
# bootstrap/install.sh. If one ever reaches git history, revoke it on GitHub — deleting the
# file does not undo the exposure.
*.pem
*.key
id_ed25519*
id_rsa*
cronus_gitops*

# Local scratch
.DS_Store
